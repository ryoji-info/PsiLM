.venv/
__pycache__/
*.pyc
*.egg-info/
.DS_Store
data/cache/
results/stage1/*.pt
results/stage1/supervisor.log
results/stage2/*.pt
results/stage2/supervisor.log
results/stage2d/*.pth
results/stage2b/*.pt
results/stage2b/supervisor.log
results/stage2d/fisher2d_data.npz
results/stage2d/dpot_ft.pt
results/stage2d/bridges.pt
results/stage2d/supervisor.log
results/stage2d/prepare.log
results/stage2b_v2/*.pt
results/stage2b_v2/supervisor.log
paper/build.log
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.log
paper/*.out
results/stage2_qwen3-1.7b/*.pt
results/stage2_qwen3-1.7b/supervisor.log
results/stage2_qwen3-1.7b/prepare.log
results/stage2b_loop2/*.pt
results/stage2b_loop2/supervisor.log
results/stage2_mlx0.5b4/*.npz
results/stage2_mlx0.5b4/*.meta
results/stage2_mlx0.5b4/supervisor.log

# blanket policy: model binaries and data blobs never enter git -- with one
# tracked exception, results/stage2/fno.pt (556 KB, the Burgers FNO that
# eval/bench_guardrail.py and psilm2 load by default; the same weights ship as
# physics/fno_burgers_singlemode.safetensors beside the backbone on the Hub)
results/**/*.pt
!results/stage2/fno.pt
results/**/*.pth
results/**/*.npz
results/**/*.meta
results/**/supervisor.log
results/**/*.log
*.safetensors
*.gguf

# guard-rail artefacts: summaries and per-question rows are the record, the
# multi-megabyte raw reports and the task caches are reproducible from them
results/bench/*_guardrail.json
!results/bench/*_guardrail_summary.json
results/bench/tasks_*.json
# ...except the caches that fix the evaluated items, so anyone can run the same ones
!results/bench/tasks_const_qwen35_n100.json
!results/bench/tasks_repguard_qwen35_n100.json
!results/bench/tasks_rt400_qwen35_n400.json
!results/bench/tasks_const_qwen0.5b_n100.json
!results/bench/tasks_qwen35_n100.json
!results/bench/tasks_gemma_n100.json
!results/bench/tasks_leaky_n100.json
results/bench/*_dryrun.json
build.log
# staging copies of the banner tracked once in assets/
results/hf_export/**/psilm-banner.png

# the constitution partner model: a full fine-tune of Qwen2.5-0.5B-Instruct,
# reproducible from data/constitution/ + eval/build_constitution_corpus.py. The
# weights and the 11 MB tokenizer copy are ignored; the card, the containment
# check and the recipe are tracked (and published with the weights on the Hub).
results/constitution_model/*
!results/constitution_model/MODEL_CARD.md
!results/constitution_model/check.json
!results/constitution_model/check.md
!results/constitution_model/finetune_qwen0.5b.sh
!results/constitution_model/s[1-6].yaml

# build_constitution_data.py's resumable work files, one JSON line per prompt.
# The record is data/constitution_{train,val,test,helpful_test}_<tag>.json, which
# holds the same items; these exist only so an interrupted build can resume.
results/constitution/*.jsonl
# per-item generation dumps, same data as the ignored raw guard-rail JSON.
# Ignored by default; the rows of some arms are tracked deliberately (git add -f)
# and `git ls-files results/bench/*.rows.jsonl` is the exact list; the rest are
# reproducible from the task caches. They are raw model output: see
# results/bench/README.md before quoting anything in them.
results/bench/*.rows.jsonl
